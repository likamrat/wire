{
  "version": 1,
  "initialization": "module",
  "tools": [
    {
      "name": "wire_github_account_snapshot",
      "description": "Read bounded, credential-free current-account metadata from this existing Copilot host for identity qualification. This is not an app-account binding attestation and does not enable WIRE profile lookup.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "wire_status",
      "description": "Read WIRE collection status and evidence coverage: approved source, last check, retained counts and any collection problem. Starts WIRE inside the Copilot app if needed. Read-only.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "wire_analytics",
      "description": "Read WIRE counts for recorded Work IQ activity: prompts, tool calls and returned entries by outcome, service, endpoint and author, including recorded failure reasons. Read-only.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "timeContext": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "timeZone",
              "locale"
            ],
            "properties": {
              "timeZone": {
                "type": "string",
                "maxLength": 100
              },
              "locale": {
                "type": "string",
                "maxLength": 80
              },
              "timeZoneFallback": {
                "type": "boolean"
              },
              "localeFallback": {
                "type": "boolean"
              }
            }
          },
          "layer": {
            "enum": [
              "tool",
              "reported-api",
              "http",
              "direct-request",
              "recorded-http",
              "code-reference"
            ]
          },
          "groupBy": {
            "enum": [
              "endpoint",
              "tool",
              "workload",
              "service"
            ]
          },
          "bucket": {
            "enum": [
              "day",
              "week",
              "month"
            ]
          },
          "timelineFrom": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scope": {
                "enum": [
                  "history",
                  "legacy",
                  "all"
                ]
              },
              "sources": {
                "type": "array",
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "github-copilot",
                    "microsoft-365-chat",
                    "microsoft-365-cowork"
                  ]
                }
              },
              "sourceSessionIds": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "endpoints": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "tools": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": "string",
                  "maxLength": 1000
                }
              },
              "workloads": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "enum": [
                    "Mail",
                    "Calendar",
                    "Files",
                    "Teams",
                    "People",
                    "Tasks",
                    "Notes",
                    "Directory",
                    "Search",
                    "Discovery",
                    "Multiple workloads",
                    "Platform metadata",
                    "Unknown"
                  ]
                }
              },
              "services": {
                "type": "array",
                "maxItems": 20,
                "items": {
                  "enum": [
                    "Mail",
                    "Calendar",
                    "Files",
                    "Teams",
                    "People",
                    "Tasks",
                    "Notes",
                    "Directory",
                    "Search",
                    "Discovery",
                    "Multiple workloads",
                    "Platform metadata",
                    "Unknown"
                  ]
                }
              },
              "activityTypes": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "enum": [
                    "workiq",
                    "direct-request",
                    "recorded-http",
                    "captured-http",
                    "code-reference"
                  ]
                }
              },
              "includeMetadata": {
                "type": "boolean"
              },
              "includeMissingService": {
                "type": "boolean"
              },
              "projectIds": {
                "type": "array",
                "maxItems": 500,
                "items": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 1000
                }
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "enum": [
                    "success",
                    "failure",
                    "unknown",
                    "partial",
                    "other",
                    "transport"
                  ]
                }
              },
              "promptAuthors": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "user",
                    "agent",
                    "unknown"
                  ]
                }
              },
              "from": {
                "type": "string",
                "maxLength": 64
              },
              "to": {
                "type": "string",
                "maxLength": 64
              }
            }
          }
        }
      }
    },
    {
      "name": "wire_search",
      "description": "Search WIRE's retained evidence on this device by literal, case-insensitive text. No AI matching. Returns matching prompts, context, replies, Work IQ actions and saved reports with short excerpts. Read-only.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "Exact text to find."
          },
          "types": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "interaction",
                "context",
                "reply",
                "action",
                "tool",
                "service",
                "report",
                "comparison",
                "view",
                "setting"
              ]
            },
            "description": "Optional result types. Omit to search all."
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Maximum results to return. Defaults to 25."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "name": "wire_diagnostic_calls",
      "description": "Read WIRE's retained Work IQ tool calls for a UTC window as MCP diagnostic records: host outcome, recorded error code and reason, HTTP and per-entry status, duration. Includes reconciled totals and coverage limits. No prompts, arguments or result bodies. Read-only.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 64,
            "description": "Inclusive UTC start (ISO 8601)."
          },
          "to": {
            "type": "string",
            "maxLength": 64,
            "description": "Exclusive UTC end (ISO 8601)."
          },
          "tools": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Optional Work IQ tool names, e.g. workiq-fetch."
          },
          "sourceSessionIds": {
            "type": "array",
            "maxItems": 500,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 1000
            },
            "description": "Optional chats."
          }
        },
        "required": []
      }
    },
    {
      "name": "wire_diagnostic_bundle",
      "description": "Prepare an MCP diagnostic report and redacted bundle from WIRE's retained Work IQ calls for a window. With save false (default) nothing is written: returns the draft report.md, headline counts, failure clusters with recorded reasons, plain limitations and a verdicts template. With save true, WIRE writes the zip and report.md to its private data folder, lists it under Reports and returns its bundleId and paths. Never sends or uploads.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "type": "string",
            "maxLength": 64,
            "description": "Inclusive start: UTC instant (ISO 8601) or calendar date."
          },
          "to": {
            "type": "string",
            "maxLength": 64,
            "description": "End: UTC instant (ISO 8601) or inclusive calendar date."
          },
          "tools": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 100
            }
          },
          "captureScope": {
            "enum": [
              "sample",
              "failures-only",
              "complete"
            ],
            "description": "Defaults to complete when WIRE includes every call in the window, otherwise sample. complete is refused when it isn't eligible."
          },
          "profile": {
            "enum": [
              "internal",
              "external"
            ],
            "description": "Defaults to internal. external minimizes identifiers; it isn't approval to share."
          },
          "verdicts": {
            "type": "object",
            "description": "A filled verdicts template from a previous preparation."
          },
          "reviewedNarrative": {
            "type": "boolean",
            "description": "Include operator narrative from verdicts; only after reviewing it for content that shouldn't be shared."
          },
          "save": {
            "type": "boolean",
            "description": "Write the bundle locally. Ask the user first."
          }
        },
        "required": []
      }
    },
    {
      "name": "wire_diagnostic_bundles",
      "description": "List diagnostic bundles saved in WIRE: bundleId, window, tools, totals, scope, profile, saved time, cluster count and how many clusters have a recorded audit verdict. Read-only.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {},
        "required": []
      }
    },
    {
      "name": "wire_inspect_bundle",
      "description": "Check an MCP diagnostic bundle without extracting it: layout, schema, checksums and cross-file counts. Give bundleId for one saved in WIRE (also verifies it is unchanged since Save and returns recorded audit results), or the absolute path of any other .zip. Returns its summary and clusters, or why it was refused. Read-only.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bundleId": {
            "type": "string",
            "maxLength": 100,
            "description": "A bundle saved in WIRE."
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Absolute path to a .zip."
          }
        },
        "required": []
      }
    },
    {
      "name": "wire_record_audit_result",
      "description": "Record one cluster's audit verdict and, optionally, its work item link on a bundle saved in WIRE. The bundle files stay unchanged; WIRE shows the result with the cluster under Reports. Use only after the audit decided the verdict, and after any work item was created or found.",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "bundleId": {
            "type": "string",
            "maxLength": 100
          },
          "clusterId": {
            "type": "string",
            "pattern": "^c-[0-9a-f]{24}$",
            "description": "Stable cluster ID, not a rank."
          },
          "verdict": {
            "enum": [
              "unclassified",
              "test-probe",
              "caller-error",
              "product-bug",
              "contract-gap",
              "by-design",
              "client-side",
              "infra-transient",
              "fixed-since",
              "not-reproduced-now"
            ]
          },
          "workItemUrl": {
            "type": "string",
            "maxLength": 2048,
            "description": "https link to the work item filed, commented on or found."
          },
          "note": {
            "type": "string",
            "maxLength": 500,
            "description": "Optional one-line reason, plain text."
          }
        },
        "required": [
          "bundleId",
          "clusterId",
          "verdict"
        ]
      }
    }
  ],
  "canvases": [
