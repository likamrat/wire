        {
          "name": "reload_snapshot",
          "description": "Reread the existing local snapshot without collecting new evidence.",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {},
            "required": []
          }
        },
        {
          "name": "move_card",
          "description": "Change local review state without changing measured outcome.",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenarioId": {
                "type": "string"
              },
              "toState": {
                "enum": [
                  "captured",
                  "reviewing",
                  "ready_to_export"
                ]
              }
            },
            "required": [
              "scenarioId",
              "toState"
            ]
          }
        },
        {
          "name": "preview_export",
          "description": "Prepare an isolated agent-owned local preview; no files written. Defaults to masked prompts and HTML. Browser disclosure is a separate owner and cannot be bypassed. Never attest to real disclosure for a user.",
          "inputSchema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "scenarioIds": {
                "type": "array",
                "minItems": 1,
                "maxItems": 500,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "selection": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "kind": {
                    "enum": [
                      "all",
                      "current",
                      "selected"
                    ]
                  },
                  "revision": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "scenarioIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string"
                    }
                  },
                  "promptAuthors": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "user",
                        "agent",
                        "unknown"
                      ]
                    }
                  }
                },
                "required": [
                  "kind",
                  "revision"
                ]
              },
              "options": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "timeContext": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "timeZone",
                      "locale"
                    ],
                    "properties": {
                      "timeZone": {
                        "type": "string",
                        "maxLength": 100
                      },
                      "locale": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "timeZoneFallback": {
                        "type": "boolean"
                      },
                      "localeFallback": {
                        "type": "boolean"
                      }
                    }
                  },
                  "dateSelection": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "range": {
                        "enum": [
                          "capture",
                          "custom",
                          "7",
                          "30"
                        ]
                      },
                      "from": {
                        "type": "string",
                        "maxLength": 80
                      },
                      "to": {
                        "type": "string",
                        "maxLength": 80
                      }
                    },
                    "required": []
                  },
                  "promptMode": {
                    "enum": [
                      "none",
                      "masked",
                      "original"
                    ]
                  },
                  "formats": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 4,
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "html",
                        "pdf",
                        "json",
                        "markdown"
                      ]
                    }
                  },
                  "manualTerms": {
                    "type": "array",
                    "maxItems": 100,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    }
                  },
                  "overrides": {
                    "type": "array",
                    "maxItems": 3000,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "key": {
