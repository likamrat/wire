        "properties": {
          "boardId": {
            "const": "workiq-evidence-board-v1"
          },
          "runtimePort": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535,
            "description": "Only for a contributor runtime started on another port. Omit to use or start WIRE on 4000."
          }
        },
        "required": []
      },
