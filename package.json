{
  "name": "work-iq-evidence",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "WIRE (Work IQ Request Explorer): inspect recorded Work IQ activity and prepare reviewed product feedback reports.",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "lucide-static": "1.52.0",
    "marked": "18.1.1",
    "pdfjs-dist": "6.3.289",
    "playwright": "1.63.0",
    "stream-chain": "4.2.6",
    "stream-json": "3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs web/*.test.mjs",
    "test:packaging": "node --test --test-concurrency=1 tests/search-packaging.qualification.mjs",
    "migrate": "node scripts/migrate.mjs",
    "install:canvas": "node scripts/install-canvas.mjs"
  }
}
